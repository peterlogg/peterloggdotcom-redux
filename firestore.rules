rules_version = '2';
// The review queue (contains chat excerpts) and labels. Admin only.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          // The admin list. Edit here, then `make deploy`.
          'loggpeter@gmail.com', 'loggpeter@googlemail.com',  // Peter
          'mark31_r@hotmail.com',                             // Russell
          'dominic.james.byrne@live.co.uk',                   // Dom
          'simonletouze@hotmail.co.uk',                       // Simon
        ];
    }
    match /review_queue/{id} {
      allow read: if isAdmin();
    }
    match /labels/{id} {
      allow read, write: if isAdmin();
    }
  }
}
