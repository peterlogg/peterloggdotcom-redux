rules_version = '2';
// Database "aker": the review queue (contains chat excerpts) and labels. Admin only.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['loggpeter@gmail.com', 'loggpeter@googlemail.com'];
    }
    match /review_queue/{id} {
      allow read: if isAdmin();
    }
    match /labels/{id} {
      allow read, write: if isAdmin();
    }
  }
}
